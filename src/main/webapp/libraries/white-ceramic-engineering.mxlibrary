er,Helvetica,Arial;fontSize=15;align=center;verticalAlign=middle;spacing=8;\" vertex=\"1\" parent=\"1\"><mxGeometry x=\"430\" y=\"75\" width=\"140\" height=\"84\" as=\"geometry\"/></mxCell><mxCell id=\"junction\" value=\"\" style=\"shape=ellipse;perimeter=ellipsePerimeter;aspect=fixed;fillColor=#5F5F5C;strokeColor=none;shadow=0;\" vertex=\"1\" parent=\"1\"><mxGeometry x=\"600\" y=\"112\" width=\"10\" height=\"10\" as=\"geometry\"/></mxCell><mxCell id=\"output\" value=\"Output &lt;i&gt;y(t)&lt;/i&gt;\" style=\"text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1A1A1A;fontFamily=Inter,Helvetica,Arial;fontSize=15;align=center;verticalAlign=middle;\" vertex=\"1\" parent=\"1\"><mxGeometry x=\"625\" y=\"100\" width=\"100\" height=\"36\" as=\"geometry\"/></mxCell><mxCell id=\"feedback\" value=\"Feedback &lt;i&gt;H(s)&lt;/i&gt;\" style=\"shape=rectangle;perimeter=rectanglePerimeter;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7F6F3;gradientDirection=south;strokeColor=#B8B8B5;strokeWidth=1;shadow=1;shadowColor=#000000;shadowOpacity=18;shadowOffsetX=0;shadowOffsetY=4;shadowBlur=6;fontColor=#1A1A1A;fontFamily=Inter,Helvetica,Arial;fontSize=15;align=center;verticalAlign=middle;spacing=8;\" vertex=\"1\" parent=\"1\"><mxGeometry x=\"300\" y=\"205\" width=\"180\" height=\"60\" as=\"geometry\"/></mxCell><mxCell id=\"e1\" style=\"shape=connector;edgeStyle=none;rounded=0;html=1;strokeColor=#5F5F5C;strokeWidth=2;startArrow=none;endArrow=classicThin;endFill=1;endSize=8;linecap=round;linejoin=round;shadow=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;\" edge=\"1\" parent=\"1\" source=\"ref\" target=\"sum\"><mxGeometry relative=\"1\" as=\"geometry\"/></mxCell><mxCell id=\"e2\" style=\"shape=connector;edgeStyle=none;rounded=0;html=1;strokeColor=#5F5F5C;strokeWidth=2;startArrow=none;endArrow=classicThin;endFill=1;endSize=8;linecap=round;linejoin=round;shadow=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;\" edge=\"1\" parent=\"1\" source=\"sum\" target=\"controller\"><mxGeometry relative=\"1\" as=\"geometry\"/></mxCell><mxCell id=\"e3\" style=\"shape=connector;edgeStyle=none;rounded=0;html=1;strokeColor=#5F5F5C;strokeWidth=2;startArrow=none;endArrow=classicThin;endFill=1;endSize=8;linecap=round;linejoin=round;shadow=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;\" edge=\"1\" parent=\"1\" source=\"controller\" target=\"plant\"><mxGeometry relative=\"1\" as=\"geometry\"/></mxCell><mxCell id=\"e4\" style=\"shape=connector;edgeStyle=none;rounded=0;html=1;strokeColor=#5F5F5C;strokeWidth=2;startArrow=none;endArrow=none;linecap=round;linejoin=round;shadow=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;\" edge=\"1\" parent=\"1\" source=\"plant\" target=\"junction\"><mxGeometry relative=\"1\" as=\"geometry\"/></mxCell><mxCell id=\"e5\" style=\"shape=connector;edgeStyle=none;rounded=0;html=1;strokeColor=#5F5F5C;strokeWidth=2;startArrow=none;endArrow=classicThin;endFill=1;endSize=8;linecap=round;linejoin=round;shadow=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;\" edge=\"1\" parent=\"1\" source=\"junction\" target=\"output\"><mxGeometry relative=\"1\" as=\"geometry\"/></mxCell><mxCell id=\"e6\" style=\"shape=connector;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;arcSize=20;html=1;strokeColor=#5F5F5C;strokeWidth=2;startArrow=none;endArrow=classicThin;endFill=1;endSize=8;linecap=round;linejoin=round;shadow=0;exitX=0.5;exitY=1;entryX=1;entryY=0.5;\" edge=\"1\" parent=\"1\" source=\"junction\" target=\"feedback\"><mxGeometry relative=\"1\" as=\"geometry\"><Array as=\"points\"><mxPoint x=\"605\" y=\"235\"/></Array></mxGeometry></mxCell><mxCell id=\"e7\" style=\"shape=connector;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;arcSize=20;html=1;strokeColor=#5F5F5C;strokeWidth=2;startArrow=none;endArrow=classicThin;endFill=1;endSize=8;linecap=round;linejoin=round;shadow=0;exitX=0;exitY=0.5;entryX=0.5;entryY=1;\" edge=\"1\" parent=\"1\" source=\"feedback\" target=\"sum\"><mxGeometr